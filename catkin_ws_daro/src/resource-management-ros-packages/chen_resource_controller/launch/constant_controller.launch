<launch>
    <arg name="constant_speed" default='2.75'/>
    <arg name="constant_freq" default='499201'/>

    <node pkg="chen_resource_controller" name="chen_resource_controller_node" type="controller" 
        args="-p 15 -s $(arg constant_speed) -f $(arg constant_freq)" 
        launch-prefix="sudo">
        <param name="scene" value="shapes_6dof"/>
        <param name="inference_mode">
    </node>

</launch>