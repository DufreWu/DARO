<launch>
  <!-- Distance surface node -->
  <node name="distance_surface" pkg="distance_surface" type="distance_surface_node" ns="distance_surface" output="screen">
    <param name="use_gpu_version" type="bool" value="true"/>
    <param name="distance_surface_formulation" type="string" value="exponential"/>
    <param name="queues_size" type="int" value="10000"/>
    <param name="req_thr" type="double" value="25"/>
    <param name="mapping" type="int" value="1"/>
    <remap from="events" to="dvs/events"/>
  </node>
</launch>
