<launch>
  <arg name="bag" default=""/>
  <arg name="v" default="0"/>
  <arg name="tracks_file_txt" default=""/>

  <!-- tracker -->
  <node name="tracker" pkg="tracker" type="tracker_node" output="screen" args="
  --flagfile=$(find tracker)/config/tracker.conf
  --v=$(arg v)
  --tracks_file_txt=$(arg tracks_file_txt)">

    <param name="req_thr" type="double" value="26"/>
    <param name="mapping" type="int" value="2"/>

    <remap from="events" to="/dvs/events"/>
    <remap from="images" to="/dvs/image_raw"/>
  </node>

 <!-- bag -->
 <group if="$(eval arg('bag') != '' )">
   <node pkg="rosbag" type="play" name="player" output="screen" args="$(arg bag)"/>
 </group>

</launch>
